# Auto detect text files and perform LF normalization
* text=auto

# Java source files
*.java text eol=lf

# Gradle files
*.gradle text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Documentation files
*.md text eol=lf
*.txt text eol=lf

# Configuration files
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Exclude generated files from export
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.idea/ export-ignore
out/ export-ignore
build/ export-ignore
*.iml export-ignore
